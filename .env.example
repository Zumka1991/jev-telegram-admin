# === Telegram ===
# Токен бота от @BotFather
BOT_TOKEN=123456:ABC-DEF_your_bot_token

# === Jev (TypeSafe System One) через OpenRouter ===
# Ключ OpenRouter: https://openrouter.ai/keys
OPENROUTER_API_KEY=sk-or-v1-xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx
# Модель. ~typesafe/jev-latest всегда указывает на свежую версию семейства.
JEV_MODEL=~typesafe/jev-latest
# Эндпоинт Decisions API (менять не нужно в большинстве случаев)
JEV_ENDPOINT=https://openrouter.ai/api/alpha/decisions
JEV_TIMEOUT_SECONDS=25
JEV_MAX_CONCURRENCY=6
# Опционально: атрибуция запросов в OpenRouter
OPENROUTER_HTTP_REFERER=
OPENROUTER_TITLE=Jev Telegram Guard

# === База данных ===
DATABASE_URL=sqlite+aiosqlite:///./data/jev.db

# === Значения по умолчанию для новых чатов ===
DEFAULT_THRESHOLD=0.55
DEFAULT_WARN_LIMIT=3
DEFAULT_MUTE_MINUTES=60
DEFAULT_FLOOD_MESSAGES=7
DEFAULT_FLOOD_SECONDS=10
# Автоудаление сообщений бота в группах, секунды (0 — не удалять)
DEFAULT_SELF_DELETE_SECONDS=0

# Догон сообщений, пропущенных пока бот был выключен (Telegram хранит апдейты до 24 ч)
BACKLOG_ENABLED=true
BACKLOG_MAX_AGE_HOURS=24
BACKLOG_LIMIT=200

# === Прочее ===
LOG_LEVEL=INFO
